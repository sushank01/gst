# Environment contract.
#
# Variables are marked [live] where a consumer now exists in the code, and
# [planned] where the name is reserved for a capability that is specified but
# not yet implemented. Copy only what you need into an ignored .env; never
# commit real credentials. All names are server-only — none is NEXT_PUBLIC.

# --- Core ---------------------------------------------------------------
# [live] Canonical origin for links, cookies and callbacks. HTTPS in production.
APP_URL=http://localhost:3000

# [live] PostgreSQL connection string. LEAVE BLANK for local development and
# tests: the app then uses PGlite (real PostgreSQL, in-process) under .data/pg,
# so there is no daemon to install. Set it in preview and production.
DATABASE_URL=

# [live] Where PGlite keeps its files when DATABASE_URL is blank.
PGLITE_DIR=.data/pg

# [live] Upper bound on pooled connections. Keep small on serverless.
DATABASE_POOL_MAX=5

# [planned] Reserved for a future signed-token capability. Sessions today are
# opaque random values stored hashed in the database and need no signing key.
AUTH_SECRET=

# [planned] Encrypts tenant-supplied connector credentials at rest. 32 random
# bytes. Not a secrets-manager dependency.
CREDENTIAL_ENCRYPTION_KEY=

# --- Email ---------------------------------------------------------------
# [planned] Verification, recovery and invitations are written to the outbox
# today and wait for a delivery adapter. Blocked on decision D3.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OAuth (decision D3) ---------------------------------------------------
# [planned] Until these are set the SSO buttons are disabled and say so. They
# never fabricate an identity.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Conditional real AI. Choose providers/models against approved cost and residency.
AI_PROVIDER=
AI_API_KEY=
AI_TEXT_MODEL=
AI_EMBEDDING_MODEL=
# Separate media/OCR adapters may add documented provider-specific names later.

# Conditional S3-compatible object storage: uploads, receipts, documents, decks.
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# On AWS prefer the service/task IAM role; do not set static object keys there.

# Conditional scheduler and remote bounded-step worker. No runtime chosen yet.
CRON_SECRET=
WORKER_BASE_URL=
WORKER_SIGNING_SECRET=
AWS_REGION=
JOBS_QUEUE_URL=
JOBS_DLQ_URL=
# Use AWS workload identity/role for AWS calls; no static AWS account keys here.

# Conditional commercial billing. Not required for the current prototype.
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
# Store provider plan/price mappings in versioned plan configuration, not fake IDs.

# Conditional optional observability, server-only; logs must redact sensitive data.
ERROR_REPORTING_DSN=

# --- Outbox delivery ------------------------------------------------------
# [live] Where the dispatcher POSTs outbox messages, per topic. A topic with no
# transport is LEFT PENDING and untouched — it is a configuration gap, not a
# delivery failure, so its retry budget is not spent. There is deliberately no
# default transport: one that always reported success would make an
# unconfigured system look like a working one.
OUTBOX_WEBHOOK_URL=
# [live] Sent as a bearer token on those requests. Never logged, never stored
# on the queue row; a test asserts it does not appear in either.
OUTBOX_WEBHOOK_SECRET=

# --- File storage ---------------------------------------------------------
# [live] Local directory for uploaded files. Path traversal outside it is
# refused by the adapter.
STORAGE_DIR=.data/files
